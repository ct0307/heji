{
  "name": "heji", "private": true, "type": "module",
  "engines": { "node": ">=24.14.0 <25" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:web": "npm run dev --workspace @heji/web",
    "dev:api": "npm run dev --workspace @heji/api",
    "db:plan": "node database/scripts/migrate.ts --plan",
    "db:migrate": "node --env-file-if-exists=.env database/scripts/migrate.ts --apply",
    "db:summary:plan": "node database/scripts/migrate-summaries.ts --plan",
    "db:summary:migrate": "node --env-file-if-exists=.env database/scripts/migrate-summaries.ts",
    "db:window:plan": "node database/scripts/migrate-windows.ts --plan",
    "db:window:migrate": "node --env-file-if-exists=.env database/scripts/migrate-windows.ts",
    "test": "node --test packages/domain/tests/*.test.ts tests/integration/*.test.ts",
    "test:domain": "node --test packages/domain/tests/*.test.ts",
    "test:db": "node --env-file-if-exists=.env --test tests/mysql/*.test.ts",
    "test:db:windows": "node --env-file-if-exists=.env --test tests/windows/mysql.test.ts",
    "test:m4": "node --test tests/integration/m4-*.test.ts",
    "test:m4:summaries": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/m4/summaries.test.ts tests/m4/write-path.test.ts",
    "m4:summary:profile": "node --env-file-if-exists=.env tests/m4/profile-summaries.ts",
    "m4:summary:rehearse": "node --env-file-if-exists=.env tests/m4/rehearse-summary-migration.ts",
    "m4:plan": "node --env-file-if-exists=.env tests/m4/cli.ts --plan",
    "m4:seed": "node --env-file-if-exists=.env tests/m4/cli.ts seed",
    "m4:benchmark": "node --env-file-if-exists=.env tests/m4/cli.ts benchmark",
    "m4:window-benchmark": "node --env-file-if-exists=.env tests/m4/cli.ts window-benchmark",
    "m4:report:participants": "node tests/m4/report-participants.ts",
    "m4:sql": "node --env-file-if-exists=.env tests/m4/cli.ts sql",
    "m4:backup": "node --env-file-if-exists=.env tests/m4/cli.ts backup",
    "m4:restore": "node --env-file-if-exists=.env tests/m4/cli.ts restore",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspace @heji/web",
    "build": "npm run typecheck && npm run build --workspace @heji/web"
  },
  "devDependencies": { "typescript": "~5.9.3", "@types/node": "^24.10.0" }
}

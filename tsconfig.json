{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["apps/api/src/**/*.ts", "packages/**/*.ts", "tests/**/*.ts", "database/scripts/**/*.ts"]
}
